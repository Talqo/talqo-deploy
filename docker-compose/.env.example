TALQO_VERSION=latest
TALQO_PORT=3000

# Base64url, 32+ bytes. Talqo refuses to start on the placeholder.
# openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# Back it up: it encrypts your AI provider keys, which are unrecoverable without it.
APP_SECRET=changeMe

# URL-safe characters only. Set once, then never change: the database ignores this
# value after first start, so changing it here locks the app out of its own database.
POSTGRES_PASSWORD=changeMe

# Optional. Uncomment to tune the end-user chat policy. See the deployment docs at
# https://docs.talqo.chat/deployment for what each one limits.
# TALQO_CHAT_DAILY_MESSAGE_LIMIT=100
# TALQO_CHAT_MAX_CONCURRENT_GENERATIONS_PER_IP=2
# TALQO_CHAT_MAX_INPUT_CHARACTERS=400000
# TALQO_CHAT_MAX_OUTPUT_TOKENS=16384
# TALQO_CHAT_GENERATION_TIMEOUT_SECONDS=120
# TALQO_TRUSTED_PROXY_CIDRS=
# TALQO_RATE_LIMIT_IPV6_PREFIX_LENGTH=64
